# First room (created on an empty database only; change the code in the app afterwards)
JOIN_CODE=CHANGE-ME
GROUP_NAME=La bande
RUST_LOG=info
# Push notifications (see README)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# FCM_SERVICE_ACCOUNT_FILE=/data/firebase.json
# Accounts (see docs/AUTH.md)
AUTH_SECRET=
PUBLIC_URL=https://quidenous.example.com
# Other web origins allowed to call the API (CORS), comma-separated; PUBLIC_URL's is always allowed
# CORS_ORIGINS=http://localhost:8081
# Behind the reverse proxy only: client IP from the last X-Forwarded-For entry (rate limits)
TRUST_PROXY=1
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_FROM=Qui de nous ? <no-reply@mg.example.com>
# MAILGUN_REGION=eu
# MAILGUN_REPLY_TO=contact@example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# OAUTH_REDIRECTS=exp://
# 1 = no anonymous join by first name (/api/join, /api/start): set it once every phone runs an app with sign-in
# AUTH_REQUIRED=1
# Account ids (users.id, comma-separated) that moderate packs and approve suggestions
# ADMIN_USER_IDS=1
# Where content reports (messages, members, questions) are emailed
# REPORT_EMAIL=contact@coflop.fr
# Over-the-air app updates: token the CI uses to publish (docs/OTA.md)
# UPDATES_PUBLISH_TOKEN=
# The OTA code signing certificate (copy of app/certs/certificate.pem in deploy/data/): unsigned updates refused
# UPDATES_CERTIFICATE=/data/ota-certificate.pem
# App crash reports to a Discord channel (webhook URL); without it they are only logged
# CLIENT_ERRORS_WEBHOOK=
# Oldest app version served (older apps get 426 and an "update" screen); unset = all
# MIN_APP_VERSION=0.33.0
