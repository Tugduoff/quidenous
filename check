#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
machine_settings="${QDN_CHECK_ENV:-$HOME/.config/quidenous/check.env}"
if [ -f "$machine_settings" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$machine_settings"
  set +a
fi

smoke_out="${SMOKE_OUT:-/tmp/qdn-smoke}"
web_build="${QDN_WEB_BUILD:-${TMPDIR:-/tmp}/qdn-web-build}"

usage() {
  cat <<'USAGE'
./check            everything below except smoke: run it before calling a change done
./check repo       comment ban and file size budgets
./check server     cargo fmt, clippy (warnings are errors), tests
./check app        tsc, eslint, knip, generated files, i18n, unit tests, native runtime, web export
./check smoke      real server + exported web app driven by Playwright; screenshots in /tmp/qdn-smoke

Machine settings (CARGO_TARGET_DIR, PLAYWRIGHT_DIR, LD_LIBRARY_PATH, PATH) are read from
~/.config/quidenous/check.env when that file exists.
USAGE
}

step() {
  printf '\n== %s\n' "$*"
}

check_repo() {
  step "repo: no comments"
  node "$repo/scripts/comments.mjs"
  step "repo: file size budgets"
  node "$repo/scripts/budgets.mjs"
}

check_server() {
  cd "$repo/server"
  step "server: fmt"
  cargo fmt --check
  step "server: clippy"
  cargo clippy --all-targets --locked -- -D warnings
  step "server: tests"
  cargo test --locked
}

export_web() {
  cd "$repo/app"
  rm -rf "$web_build"
  CI=1 npx expo export --platform web --output-dir "$web_build"
}

check_app() {
  cd "$repo/app"
  step "app: types"
  npx tsc --noEmit
  step "app: lint"
  npx eslint . --max-warnings 0
  step "app: dead code"
  npx knip
  step "app: generated files and translations"
  node scripts/mascot-parts.mjs --check
  node scripts/check-i18n-module-t.mjs
  step "app: unit tests"
  find src -name '*.test.ts' -print0 | xargs -0 npx tsx --test
  step "app: native runtime"
  node "$repo/scripts/native-runtime.mjs"
  step "app: web export"
  export_web
}

smoke() {
  step "smoke: build"
  (cd "$repo/server" && cargo build --locked)
  [ -f "$web_build/index.html" ] || export_web
  local target="${CARGO_TARGET_DIR:-$repo/server/target}"
  step "smoke: run"
  rm -rf "$smoke_out"
  mkdir -p "$smoke_out"
  SMOKE_SERVER_BIN="$target/debug/quidenous-server" SMOKE_WEB_DIR="$web_build" SMOKE_OUT="$smoke_out" \
    node "$repo/scripts/smoke.mjs"
}

case "${1:-all}" in
  all)
    check_repo
    check_server
    check_app
    printf '\nAll checks passed.\n'
    ;;
  repo) check_repo ;;
  server) check_server ;;
  app) check_app ;;
  smoke) smoke ;;
  -h | --help | help) usage ;;
  *)
    usage
    exit 2
    ;;
esac
