{
  "expo": {
    "name": "qui de nous ?",
    "slug": "quidenous",
    "version": "0.39.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quidenous",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tugduoff.quidenous"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tugduoff.quidenous",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 67
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8FF3D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour ta photo de profil et les photos du chat.",
          "cameraPermission": "Pour scanner un QR code ou prendre une photo dans le chat."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pour scanner un QR code ou prendre une photo dans le chat.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pour verrouiller l’app avec Face ID."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://qdn.coflop.fr/api/updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
